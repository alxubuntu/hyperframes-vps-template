# Copy to .env before starting the stack. Do not commit API keys or .env.
# AI generation is BYOK: OpenRouter or DeepSeek keys are entered in the UI per
# user and are never stored here.
# BIND_ADDR is the host interface the app publishes on. Keep 127.0.0.1 behind
# a reverse proxy; use 0.0.0.0 only when the app is exposed directly.
BIND_ADDR=127.0.0.1
# Host port. Leave 3000 for a single instance; set WEB_PORT= (empty) to let
# Docker assign a free port, discoverable with `docker compose port hyperframes 3000`.
WEB_PORT=3000
ENABLE_AI_GEN=true
PREVIEW_COMPOSITION_DIR=compositions/cloudflare-intro

# One render at a time avoids competing Chromium processes. Each job can use
# several HyperFrames workers; tune against the VPS's available CPU/RAM.
RENDER_CONCURRENCY=1
RENDER_WORKERS=2
RENDER_TIMEOUT_MS=600000
HYPERFRAMES_BIN=./renderer/node_modules/.bin/hyperframes

# Size caps. Base64 inflates an upload by ~33%, so a 24 MB composition arrives
# as a ~32 MB request body: raise the request cap above the composition cap.
# MAX_REQUEST_BYTES=67108864        # 64 MB  whole request, every route
# MAX_RENDER_HTML_BYTES=33554432    # 32 MB  { "html": "..." }; code default is 32 MB
# MAX_COMPOSITION_BYTES=50331648    # 48 MB  decoded { "files": [...] }; defaults to
#                                   #        0.75 x MAX_REQUEST_BYTES (base64 overhead)

# Set true only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=false
