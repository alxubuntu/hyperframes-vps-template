# Copy to .env before starting the stack. Do not commit API keys or .env.
#
# IMPORTANT: keep this file to plain KEY and value pairs, one per line. Never
# put an equals sign inside a comment: some hosting panels import the file line
# by line and turn such a comment into a broken environment variable.
#
# AI generation is BYOK: OpenRouter or DeepSeek keys are entered in the UI per
# user and are never stored here.

# Host interface the app publishes on. Keep 127.0.0.1 behind a reverse proxy;
# use 0.0.0.0 only when the app is exposed directly.
BIND_ADDR=127.0.0.1

# Host port. Empty means Docker assigns a free one, so two instances never
# collide: read it back with "docker compose port hyperframes 3000". Pin a
# number (3001, 3002, ...) when the URL has to stay stable across recreates.
WEB_PORT=

# Optional Traefik routing. Leave TRAEFIK_ENABLE as false to publish a port
# instead. With it true, set TRAEFIK_HOST to the public name, and give every
# instance a unique TRAEFIK_ROUTER (router names are global to the proxy).
TRAEFIK_ENABLE=false
TRAEFIK_ROUTER=hyperframes
TRAEFIK_HOST=
TRAEFIK_CERTRESOLVER=letsencrypt

ENABLE_AI_GEN=true
PREVIEW_COMPOSITION_DIR=compositions/cloudflare-intro

# One render at a time avoids competing Chromium processes. Each job can use
# several HyperFrames workers; tune against the VPS's available CPU/RAM.
RENDER_CONCURRENCY=1
RENDER_WORKERS=2
RENDER_TIMEOUT_MS=600000
# Compose already sets HYPERFRAMES_BIN to the path inside the image. Only set
# it here for a bare-metal run, and use an absolute path to the CLI binary.
# HYPERFRAMES_BIN  (set by the compose file)

# Optional size caps, only if you need to override the code defaults: request
# 64 MB, single HTML 32 MB, composition 0.75 of the request cap. Names are
# MAX_REQUEST_BYTES, MAX_RENDER_HTML_BYTES and MAX_COMPOSITION_BYTES.

# REQUIRED behind Traefik or another trusted TLS proxy, otherwise HTTPS login
# fails with invalid_origin. The proxy must overwrite forwarded headers and
# direct untrusted access to the application port must be blocked.
TRUST_PROXY_HEADERS=false

# Authentication is enabled unless explicitly set to false. Set a random
# password of at least 16 characters before starting the app.
AUTH_ENABLED=true
AUTH_PASSWORD=
# Optional random signing key; changing it invalidates all browser sessions.
AUTH_SECRET=
# Optional separate token for scripts and n8n. Unset disables bearer access.
AUTH_API_TOKEN=
AUTH_SESSION_HOURS=12
# Keep true for HTTPS. Set false only for local HTTP or a protected tunnel.
AUTH_COOKIE_SECURE=true
